+CFTypeRefPtr<IOSurfaceRef> NativeLayerRootCA::CopyCompositorSurface(
+    uint64_t* aVersion, gfx::IntSize* aSize) {
+  MutexAutoLock lock(mMutex);
+  if (aVersion) {
+    *aVersion = mCompositorSurfaceVersion;
+  }
+  if (aSize) {
+    *aSize = mCompositorSurface
+                 ? gfx::IntSize(IOSurfaceGetWidth(mCompositorSurface.get()),
+                                IOSurfaceGetHeight(mCompositorSurface.get()))
+                 : gfx::IntSize();
+  }
+  return mCompositorSurface;
+}
+
+void NativeLayerRootCA::SetCompositorSurfaceChangedCallback(
+    std::function<void()>&& aCallback) {
+  MutexAutoLock lock(mMutex);
+  mCompositorSurfaceChangedCallback = std::move(aCallback);
+}
+
+CFTypeRefPtr<IOSurfaceRef> NativeLayerRootCA::FindCompositorSurface(
+    const MutexAutoLock& aProofOfLock) {
+  CFTypeRefPtr<IOSurfaceRef> selected;
+  size_t selectedArea = 0;
+  for (const auto& layer : mSublayers) {
+    CFTypeRefPtr<IOSurfaceRef> surface = layer->CopyFrontSurface();
+    if (!surface || IOSurfaceGetPlaneCount(surface.get()) != 0) {
+      continue;
+    }
+    const size_t width = IOSurfaceGetWidth(surface.get());
+    const size_t height = IOSurfaceGetHeight(surface.get());
+    const size_t area = width * height;
+    if (area >= selectedArea) {
+      selected = std::move(surface);
+      selectedArea = area;
+    }
+  }
+  return selected;
+}
+
+bool NativeLayerRootCA::UpdateCompositorSurface(
+    const MutexAutoLock& aProofOfLock) {
+  CFTypeRefPtr<IOSurfaceRef> surface = FindCompositorSurface(aProofOfLock);
+  const IOSurfaceID oldID = mCompositorSurface
+                                ? IOSurfaceGetID(mCompositorSurface.get())
+                                : 0;
+  const IOSurfaceID newID = surface ? IOSurfaceGetID(surface.get()) : 0;
+  if (oldID == newID) {
+    return false;
+  }
+  mCompositorSurface = std::move(surface);
+  ++mCompositorSurfaceVersion;
+  if (mCompositorSurfaceNotificationPending) {
+    return false;
+  }
+  mCompositorSurfaceNotificationPending = true;
+  return true;
+}
+
+void NativeLayerRootCA::DispatchCompositorSurfaceChanged() {
+  RefPtr<NativeLayerRootCA> self = this;
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "NativeLayerRootCA::DispatchCompositorSurfaceChanged",
+      [self = std::move(self)]() {
+        std::function<void()> callback;
+        {
+          MutexAutoLock lock(self->mMutex);
+          self->mCompositorSurfaceNotificationPending = false;
+          callback = self->mCompositorSurfaceChangedCallback;
+        }
+        if (callback) {
+          callback();
+        }
+      }));
+}
